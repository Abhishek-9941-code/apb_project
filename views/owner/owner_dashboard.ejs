<% layout('/layout/boilerplat.ejs') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">Owner Dashboard</h2>
      <p class="text-muted mb-0">Offline sales and business analytics</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/apb/owner/offline-sale" class="btn btn-primary">New Offline Sale</a>
      <a href="/apb/owner/analytics" class="btn btn-outline-primary" onclick="return ensureOwnerAccess(event)">Analytics</a>
    </div>
  </div>

  <script>
    function ensureOwnerAccess(event) {
      const isOwner = <%= !!(currUser && currUser.role === 'owner') %>;
      if (!isOwner) {
        event.preventDefault();
        alert('Please login as owner to view analytics.');
        window.location.href = '/apb/login';
        return false;
      }
      return true;
    }
  </script>

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body">
          <div class="text-muted small">Sales History</div>
          <a href="/apb/owner/sales-history" class="btn btn-link p-0 mt-2">View all sales</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body">
          <div class="text-muted small">Customers</div>
          <a href="/apb/owner/sales-history" class="btn btn-link p-0 mt-2">See customer activity</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body">
          <div class="text-muted small">Inventory</div>
          <a href="/apb/top_product" class="btn btn-link p-0 mt-2">Manage products</a>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <h5 class="mb-3">Quick product lookup</h5>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Product</th>
              <th>Category</th>
              <th>Stock</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
              <tr>
                <td><%= product.name %></td>
                <td><%= product.Category %></td>
                <td><%= product.stock || 0 %></td>
                <td>₹<%= product.Selling_price %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
