    <script>
        function changeQty(btn, delta) {
            const control = btn.parentElement;
            const span = control.querySelector('span');
            let qty = parseInt(span.textContent);
            qty = Math.max(1, qty + delta);
            span.textContent = qty;
        }

        // Remove item with animation
        document.querySelectorAll('.btn-remove').forEach(btn => {
            btn.addEventListener('click', function() {
                const item = this.closest('.cart-item');
                item.style.transition = 'opacity 0.3s, transform 0.3s';
                item.style.opacity = '0';
                item.style.transform = 'translateX(30px)';
                setTimeout(() => item.remove(), 300);
            });
        });
    </script>
    <!-- ═══════════════ SEARCH LOGIC ═══════════════ -->
<script>
  let debounceTimer;
  let abortController;

  const searchInput   = document.getElementById('searchInput');
  const searchDropdown = document.getElementById('searchDropdown');

  // ── Typing pe autocomplete ──
  searchInput.addEventListener('input', function () {
    const query = this.value.trim();

    clearTimeout(debounceTimer);

    if (query.length < 2) {
      closeDropdown();
      return;
    }

    debounceTimer = setTimeout(async () => {
      if (abortController) abortController.abort();
      abortController = new AbortController();

      try {
        const res  = await fetch(`/search?q=${encodeURIComponent(query)}`, {
          signal: abortController.signal,
          headers: {
            'Accept': 'application/json'
          }
        });
        if (!res.ok) throw new Error('Search request failed');
        const data = await res.json();
        renderDropdown(data, query);
      } catch (err) {
        // aborted or parse error — ignore silently
      }
    }, 350);
  });

  // ── Dropdown render ──
// 2. renderDropdown mein pehle ek search row add karo
function renderDropdown(data, query) {
    let html = `
        <div onclick="doSearch()" style="
          padding:10px 16px; cursor:pointer;
          font-size:14px; color:#7b2ff7;
          border-bottom:2px solid #ede7ff;
          font-weight:600;
        "
        onmouseover="this.style.background='#f8f5ff'"
        onmouseout="this.style.background='white'">
          <i class="fa fa-search" style="margin-right:8px;"></i>
          Search "<strong>${query}</strong>"
        </div>
    `;

    html += data.map(item => `
        <div onclick="window.location.href='/apb/fullproduct/${item._id}'" style="
          padding:10px 16px; cursor:pointer;
          font-size:14px; color:#1a1a2e;
          display:flex; justify-content:space-between; align-items:center;
          border-bottom:1px solid #f3eeff;
        "
        onmouseover="this.style.background='#f8f5ff'"
        onmouseout="this.style.background='white'">
          <span><i class="fa fa-box" style="color:#ccc; font-size:12px; margin-right:8px;"></i>${item.name}</span>
          <span style="font-size:11px; background:#f0eaff; color:#7b2ff7; padding:2px 10px; border-radius:20px;">${item.Category}</span>
        </div>
    `).join('');

    searchDropdown.innerHTML = html;
    searchDropdown.style.display = 'block';
}

  // ── Item select karne pe ──
  function selectItem(name) {
    searchInput.value = name;
    closeDropdown();
    doSearch();
  }

  // ── Search button / Enter ──
  function doSearch() {
    const query = searchInput.value.trim();
    if (!query) return;
    window.location.href = `/search?q=${encodeURIComponent(query)}`;
  }

  searchInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') doSearch();
    if (e.key === 'Escape') closeDropdown();
  });

  // ── Bahar click pe band ──
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.search-wrap')) closeDropdown();
  });

  function closeDropdown() {
    searchDropdown.style.display = 'none';
    searchDropdown.innerHTML = '';
  }
</script>
<script>
    function openAccountDrawer() {
        document.getElementById('accountDrawer').style.right = '0';
        document.getElementById('accountOverlay').style.display = 'block';
        document.body.style.overflow = 'hidden';
    }
    function closeAccountDrawer() {
        document.getElementById('accountDrawer').style.right = '-320px';
        document.getElementById('accountOverlay').style.display = 'none';
        document.body.style.overflow = '';
    }
</script>
