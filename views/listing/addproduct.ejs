
<%- layout("/layout/boilerplat.ejs") %>

<% if(addProduct && addProduct.length) { %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
  <%= addProduct %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<body>

     <!-- include("../include/header.ejs")  -->

    <!-- Hero Banner -->
    <section class="page-hero">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-3">
                    <li class="breadcrumb-item"><a href="/apb/home"><i class="fa fa-home me-1"></i>Home</a></li>
                    <li class="breadcrumb-item"><a href="/apb/top_product">Top Products</a></li>
                    <li class="breadcrumb-item active">Add Product</li>
                </ol>
            </nav>
            <h1><i class="fa fa-plus-circle me-2" style="font-size:1.8rem;vertical-align:middle;"></i>Add New Product</h1>
            <p>Fill in the details below to list a new product in the store</p>
        </div>
    </section>

    <!-- Form Card -->
    <div class="container mb-5">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                <!-- <div class="form-card"> -->
                    <form id="addProductForm" action="/product/add" method="POST" enctype="multipart/form-data" novalidate class="needs-validation">
                        <br> 
                        <!-- ── BASIC DETAILS ── -->
                        <p class="section-label"><i class="fa fa-tag"></i> Basic Details</p>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Product Name <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control" placeholder="e.g. Premium Gel Pen Set – 36 Colors" required>
                                <div class="invalid-feedback">Product name is required.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Category <span class="text-danger">*</span></label>
                                <select name="Category" class="form-select" id="categorySelect" required>
                                    <option value="" disabled selected>Select category</option>
                                    <option value="books">📚 Books</option>
                                    <option value="electronics">💻 Electronics</option>
                                    <option value="study_materials">🎓 Study Materials</option>
                                    <option value="stationery">🖊️ Stationery</option>
                                    <option value="other">📦 Other</option>
                                </select>
                                <div class="invalid-feedback">Please select a category.</div>
                            </div>
                        </div>
 
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea name="description" class="form-control" placeholder="Write a short description about the product..."></textarea>
                            </div>
                        </div>

                        <!-- ── PRICING ── -->
                        <p class="section-label"><i class="fa fa-indian-rupee-sign"></i> Pricing</p>

                        <div class="row g-3 mb-4 align-items-end">
                            <div class="col-sm-4">
                                <label class="form-label">Selling Price <span class="text-danger">*</span></label>
                                <div class="input-group price-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" name="Selling_price" id="priceInput" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="invalid-feedback">Enter selling price.</div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label">Original MRP</label>
                                <div class="input-group price-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" name="orginal_price" id="mrpInput" class="form-control" placeholder="0" min="0">
                                </div>
                            </div>
                            <div class="col-sm-4 d-flex align-items-center gap-2 pb-1">
                                <span id="discountBadge"><i class="fa fa-percent me-1"></i><span id="discountVal">0</span>% off</span>
                            </div>
                        </div>

                        <!-- ── PRODUCT STATUS & BADGE ── -->
                        <p class="section-label"><i class="fa fa-fire"></i> Status & Badge</p>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Product Badge</label>
                                <select name="badge" class="form-select">
                                    <option value="">No Badge</option>
                                    <option value="Bestseller">🏆 Bestseller</option>
                                    <option value="New">✨ New</option>
                                    <option value="Hot">🔥 Hot</option>
                                    <option value="Sale">🏷️ Sale</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label d-block">Availability</label>
                                <div class="d-flex gap-2 mt-1">
                                    <div class="status-option">
                                        <input type="radio" name="status" id="inStock" value="instock" checked>
                                        <label for="inStock"><i class="fa fa-check-circle me-1"></i>In Stock</label>
                                    </div>
                                    <div class="status-option">
                                        <input type="radio" name="status" id="outStock" value="outofstock">
                                        <label for="outStock"><i class="fa fa-times-circle me-1"></i>Out of Stock</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── RATINGS ── -->
                        <p class="section-label"><i class="fa fa-star"></i> Initial Ratings</p>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-4">
                                <label class="form-label">Rating (0 – 5)</label>
                                <input type="number" name="rating" class="form-control" placeholder="4.5" min="0" max="5" step="0.1">
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label">Review Count</label>
                                <input type="text" name="review_count" class="form-control" placeholder="e.g. 1.2k">
                            </div>
                        </div>

                        <!-- ── IMAGE UPLOAD ── -->
                        <p class="section-label"><i class="fa fa-image"></i> Product Image</p>

                        <!-- <div class="mb-4">
                            <div class="upload-zone" id="uploadZone">
                                <input type="file" name="image" id="imageInput" accept="image/*">
                                <div class="upload-icon"><i class="fa fa-cloud-upload-alt"></i></div>
                                <p><span>Click to upload</span> or drag & drop</p>
                                <p class="mt-1" style="font-size:0.78rem;">PNG, JPG, WEBP — Max 5 MB</p>
                            </div>
                            <div id="imagePreviewWrap" class="d-flex gap-2 flex-wrap mt-3">
                                <img id="imagePreview" src="" alt="Preview">
                                <button type="button" id="removeImg" class="btn btn-sm btn-outline-danger align-self-start" style="border-radius:8px;">
                                    <i class="fa fa-trash-alt me-1"></i> Remove
                                </button>
                            </div>
                        </div> -->

                        <input type="file" name="image" id="imageInput" class="form-control mb-4" required>
                        <!-- ── ACTION BUTTONS ── -->
                        <hr style="border-color: var(--border); margin: 28px 0;">
                        <div class="d-flex flex-wrap gap-3 justify-content-end">
                            <button type="reset" class="btn-reset" id="resetBtn">
                                <i class="fa fa-rotate-left me-2"></i>Reset
                            </button>
                            <button type="submit" class="btn-submit">
                                <i class="fa fa-plus me-2"></i>Add Product
                            </button>
                        </div>

                    </form>
                <!-- </div> -->
            </div>
        </div>
    </div>

    <!-- Success Toast -->
    <div id="successToast">
        <i class="fa fa-circle-check fa-lg"></i>
        <span>Product added successfully!</span>
    </div>


     <!-- <script src="/js/add_top_product.js"></script>  -->
