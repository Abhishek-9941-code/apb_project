<% layout("/layout/boilerplat.ejs") %>

<section class="section-pad" id="top-products">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4 scroll-reveal">
      <div>
        <h2 class="section-title mb-1">Top <span class="grad-text">Products</span></h2>
        <p class="section-sub mb-0">Hand-picked bestsellers just for you</p>
      </div>
      <a href="/apb/add_product" class="btn-signup-nav" style="font-size:.82rem">Add product <i class="fa fa-arrow-right ms-1"></i></a>
    </div>
    <div class="row g-4 scroll-reveal">
      <% for(let d of data)  { %>
        <!-- Card 1 -->
        <div class="col-6 col-md-4 col-lg-3">
          <div class="prod-card">
            <div class="prod-img-wrap">
              <img src=<%= d.image %> alt="Book">
              <span class="prod-badge">Bestseller</span>
              <div class="prod-wishlist"><i class="fa-regular fa-heart"></i></div>
            </div>
            <div class="prod-body">
              <div class="prod-cat">
                <%= d.Category %>
              </div>
              <div class="prod-name">
                <%= d.name %>
              </div>
              <div class="stars">★★★★★ <span>(1.2k)</span></div>
              <div class="prod-price">
                <span class="price-new">
                  <%= "₹" + d.Selling_price %>
                </span>
                <span class="price-old">₹599</span>
                <span class="price-save">37% off</span>
              </div>
              <button class="btn-cart"><i class="fa-solid fa-cart-plus me-2"></i>Add to Cart</button>
            </div>
          </div>
        </div>
      <% } %>
