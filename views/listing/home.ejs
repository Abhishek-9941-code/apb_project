<% layout("/layout/boilerplat.ejs") %>

<% if(success && success.length) { %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
  <%= success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>


<!-- ═══════════════ HERO ═══════════════ -->
<section class="hero">
  <div class="hero-orb orb1"></div>
  <div class="hero-orb orb2"></div>
  <div class="container py-5">
    <div class="row align-items-center gy-5">
      <div class="col-lg-6 hero-content">
        <div class="hero-eyebrow"><i class="fa-solid fa-bolt"></i> New Arrivals Every Week</div>
        <h1>Discover the Best <span>Books &amp; Products</span> in One Place</h1>
        <p>Your one-stop destination for books, electronics, study materials and more — curated with care, delivered with love.</p>
        <div class="hero-search">
          <i class="fa-solid fa-magnifying-glass me-2" style="color:#9CA3AF"></i>
          <input type="text" placeholder="What are you looking for today?">
          <button>Find Now</button>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="num">50K+</span><span class="lbl">Products</span></div>
          <div class="hero-stat"><span class="num">120K+</span><span class="lbl">Customers</span></div>
          <div class="hero-stat"><span class="num">4.9★</span><span class="lbl">Avg Rating</span></div>
        </div>
      </div>
      <div class="col-lg-6 hero-visual position-relative d-flex justify-content-center">
        <div class="hero-card-main" style="position:relative">
          <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400" alt="Books">
          <div style="padding:12px 0 0">
            <div style="font-size:.75rem;color:var(--primary);font-weight:700;text-transform:uppercase;letter-spacing:.5px">Best Seller</div>
            <div style="font-weight:800;font-size:1rem;margin:4px 0">Atomic Habits</div>
            <div style="color:#FBBF24;font-size:.8rem">★★★★★ <span style="color:#9CA3AF">(2.4k reviews)</span></div>
            <div style="color:var(--primary);font-weight:800;font-size:1.1rem;margin-top:6px">₹499 <span style="color:#9CA3AF;text-decoration:line-through;font-size:.85rem;font-weight:400">₹799</span></div>
          </div>
        </div>
        <div class="hero-badge-float hbf1"><i class="fa-solid fa-shield-halved me-1" style="color:var(--primary)"></i>Secure Checkout</div>
        <div class="hero-badge-float hbf2"><i class="fa-solid fa-truck-fast me-1" style="color:var(--secondary)"></i>Free Delivery ₹499+</div>
      </div>
    </div>
  </div>
</section>

