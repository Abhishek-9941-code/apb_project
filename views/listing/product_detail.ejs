<%- layout("/layout/boilerplat.ejs") %>

<% if(review && review.length) { %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
  <%= review %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>


<% if(deleteReview && deleteReview.length) { %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
  <%= deleteReview %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<% if(success && success.length) { %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
  <%= success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>
<div class="pd-breadcrumb-wrap container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/apb/home">Home</a></li>
            <li class="breadcrumb-item"><a href="/apb/top_product"><%= prod.Category %></a></li>
            <li class="breadcrumb-item active"><%= prod.name %></li>
        </ol>
    </nav>
</div>

<!-- ══ PRODUCT MAIN ══ -->
<main class="container pd-section">
    <div class="row g-4">

        <!-- LEFT: Image -->
        <div class="col-lg-5 col-md-6">
            <div class="pd-img-wrap">
                <span class="pd-badge-bestseller">
                    <% if(prod.badge && prod.badge !== 'No Badge') { %>
                        <i class="fa-solid fa-fire-flame-curved me-1"></i><%= prod.badge %>
                    <% } else { %>
                        <i class="fa-solid fa-fire-flame-curved me-1"></i>Bestseller
                    <% } %>
                </span>
                <button class="pd-wishlist-btn" id="wishlistBtn" onclick="toggleWishlist(this)">
                    <i class="fa-regular fa-heart"></i>
                </button>
                <img id="mainImg" src="<%= prod.image %>" alt="<%= prod.name %>">
            </div>
        </div>

        <!-- RIGHT: Info -->
        <div class="col-lg-7 col-md-6 pd-info">

            <p class="pd-category">
                <i class="fa-solid fa-tag me-1"></i><%= prod.Category %>
            </p>

            <h1 class="pd-title"><%= prod.name %></h1>

            <!-- Rating -->
            <div class="pd-rating-row">
                <div class="pd-stars">
                    <% 
                        let rating = parseFloat(prod.rating) || 0;
                        for(let i = 1; i <= 5; i++) {
                            if(i <= Math.floor(rating)) { %>
                                <i class="fa-solid fa-star"></i>
                            <% } else if(i - rating < 1) { %>
                                <i class="fa-solid fa-star-half-stroke"></i>
                            <% } else { %>
                                <i class="fa-regular fa-star"></i>
                            <% } 
                        } 
                    %>
                </div>
                <span class="pd-rating-avg"><%= prod.rating %></span>
                <span class="pd-rating-count">(<%= prod.review_count %> reviews)</span>
            </div>

            <!-- Price (no original price) -->
            <div class="pd-price-row">
                <div class="pd-price-sell"><span>₹</span><%= prod.Selling_price %></div>
                <% 
                    if(prod.orginal_price && prod.orginal_price > prod.Selling_price) {
                        let disc = Math.round((1 - prod.Selling_price / prod.orginal_price) * 100);
                %>
                    <span class="pd-discount-badge">
                        <i class="fa-solid fa-bolt me-1"></i><%= disc %>% OFF
                    </span>
                <% } %>
            </div>

            <!-- Stock -->
            <div class="mb-3">
                <% if(prod.Availability) { %>
                    <span class="pd-stock-badge pd-stock-in">
                        <i class="fa-solid fa-circle"></i> In Stock
                    </span>
                <% } else { %>
                    <span class="pd-stock-badge pd-stock-out">
                        <i class="fa-solid fa-circle"></i> Out of Stock
                    </span>
                <% } %>
            </div>

            <!-- Description -->
            <p class="pd-desc-label">About this product</p>
            <p class="pd-desc"><%= prod.description %></p>

            <!-- OWNER PRODUCT ACTIONS -->
<% if(currUser && currUser.role === "owner") { %>

    <div class="d-flex gap-2 mb-3">

        <a href="/apb/fullproduct/<%= prod._id %>/edit"
           class="btn btn-outline-primary">
            <i class="fa-solid fa-pen-to-square me-1"></i>
            Edit Product
        </a>

     <form action="/apb/fullproduct/<%= prod._id %>/delete"
      method="POST"
      onsubmit="return confirm('Are you sure you want to delete this product?');">
      <input type="hidden" name="_method" value="DELETE">

    <button type="submit"
            class="btn btn-outline-danger">

        <i class="fa-solid fa-trash me-1"></i>
        Delete Product

    </button>

</form>

    </div>

<% } %>

            <form action="/addCart/<%= prod._id %>", method="post">
                <p class="pd-qty-label">Quantity</p>
            <div class="pd-qty-wrap">
                <button class="pd-qty-btn" onclick="changeQty(-1) ">
                    <i class="fa-solid fa-minus"></i>
                </button>
                <input class="pd-qty-input" type="number" id="qtyInput" value="1" min="1" max="99" name="quantity">
                <button class="pd-qty-btn" onclick="changeQty(1)">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
            <div class="pd-action-row">
                <% if(prod.Availability) { %>
                    <button type="submit" class="pd-btn-cart">
                        <i class="fa-solid fa-cart-shopping"></i> Add to Cart
                    </button>
                    
                    <button class="pd-btn-buy">
                        <i class="fa-solid fa-bolt"></i> Buy Now
                    </button>
                <% } else { %>
                    <button class="pd-btn-cart" disabled style="opacity:0.5;cursor:not-allowed;">
                        <i class="fa-solid fa-cart-shopping"></i> Out of Stock
                    </button>
                <% } %>
            </div>
                
                </form>

                

            <!-- Quantity -->
            

            <!-- Action Buttons -->
            

            <hr class="pd-divider">

            <!-- Info Pills -->
            <div class="pd-info-pills">
                <div class="pd-pill"><i class="fa-solid fa-truck-fast"></i> Free Delivery above ₹499</div>
                <div class="pd-pill"><i class="fa-solid fa-rotate-left"></i> 7-Day Returns</div>
                <div class="pd-pill"><i class="fa-solid fa-shield-halved"></i> Secure Payment</div>
            </div>
        </div>
    </div>

    <!-- ══ TABS ══ -->
    <div class="pd-tabs mt-5">
        <ul class="nav nav-tabs" id="pdTab">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pdDesc">Description</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pdSpecs">Specifications</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pdReviews">
                    Reviews (<%= prod.review_count %>)
                </button>
            </li>
        </ul>
        <div class="tab-content pt-4">

            <!-- Description Tab -->
            <div class="tab-pane fade show active" id="pdDesc">
                <p><%= prod.description %></p>
            </div>

            <!-- Specs Tab -->
            <div class="tab-pane fade" id="pdSpecs">
                <table class="pd-specs-table">
                    <tr><td>Product Name</td><td><%= prod.name %></td></tr>
                    <tr><td>Category</td><td><%= prod.Category %></td></tr>
                    <tr><td>Availability</td><td><%= prod.Availability ? 'In Stock' : 'Out of Stock' %></td></tr>
                    <tr><td>Rating</td><td><%= prod.rating %> / 5</td></tr>
                    <tr><td>Total Reviews</td><td><%= prod.review_count %></td></tr>
                    <tr><td>Badge</td><td><%= prod.badge || 'N/A' %></td></tr>
                </table>
            </div>

            <!-- Reviews Tab -->
            <div class="tab-pane fade" id="pdReviews">
                <div class="pd-review-summary mb-4">
                    <div class="pd-big-rating"><%= prod.rating %></div>
                    <div>
                        <div class="pd-stars-lg">
                            <% for(let i = 1; i <= 5; i++) {
                                if(i <= Math.floor(rating)) { %>
                                    <i class="fa-solid fa-star"></i>
                                <% } else if(i - rating < 1) { %>
                                    <i class="fa-solid fa-star-half-stroke"></i>
                                <% } else { %>
                                    <i class="fa-regular fa-star"></i>
                                <% } } %>
                        </div>
                        <p class="pd-review-total">Based on <%= prod.review_count %> reviews</p>
                    </div>
                </div>
                <!-- Static sample reviews — replace with DB data when available -->
              <% for(let i = 0; i < prod.reviews.length; i++) { %>
                    <div class="pd-review-card">
                    
                    <div class="d-flex justify-content-between">
                        <span class="pd-reviewer"><%= prod.reviews[i].owner ? prod.reviews[i].owner.username : 'Anonymous' %></span>
                        <span class="pd-review-date"><%=prod.reviews[i].createdAt %></span>
                    </div>
                 <div class="pd-stars">
                        <% for(var j = 0; j < prod.reviews[i].rating; j++){ %>
                        <i class="fa-solid fa-star"></i>
                        <% } %>
                        <% for(let k = j; k < 5; k++) { %>
                        <i class="fa-regular fa-star"></i>
                        <% } %>
                    </div> 
                      
                    <p class="pd-review-text"><%= prod.reviews[i].comment %></p>
                    <form action="/apb/product/<%= prod._id %>/reviews/<%= prod.reviews[i]._id%>" method="POST">
                        <input type="hidden" name="_method" value="DELETE">
                        <% if(currUser && prod.reviews[i].owner) {
                            const ownerId = prod.reviews[i].owner._id ? prod.reviews[i].owner._id.toString() : prod.reviews[i].owner.toString();
                            if(ownerId === currUser._id.toString()) { %>
                            <button class="btn btn-outline-primary">Delete</button>
                        <% } } %>
                    </form>
                       
                    
                </div>
                
                <% } %>
                
            </div>
        </div>
    </div>
</main>

<div class="col-8 offset-3 mb-3 mt-3">
    <h4>leave a Review</h4>
    <% if(currUser) { %>
        <form action="/apb/<%= prod._id %>/reviews/<%= currUser._id %>" method="POST" novalidate class="needs-validation">

           
            <fieldset class="starability-slot" aria-label="Select a rating for this product">
            <legend>First rating:</legend>
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" aria-label="No rating." />
            <input type="radio" id="first-rate5" name="review[rating]" value="5" required />
            <label for="first-rate5" title="Amazing">5 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" required />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" required />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" required />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
            <label for="first-rate1" title="Terrible">1 star</label>
            </fieldset>
            <div class="invalid-feedback d-block mt-2">Please select a star rating before submitting.</div>
            <label for="comment" class="form-label">Comment</label>
            <br>
            <textarea name="review[comment]" id="comment" placeholder="give you valuable review" class="form-control" minlength="3" required></textarea>
            <div class="invalid-feedback">Please add some comments for review</div>
            <button type="submit" class="btn btn-outline-primary">submit</button>
        </form>
    <% } else { %>
        <p class="pd-login-review">
        <i class="fas fa-lock"></i>
        Please <a href="/apb/login">login</a> to leave a review.
</p>
    <% } %>
</div>


<!-- ══ RELATED PRODUCTS ══ -->
<% if(relatedProducts && relatedProducts.length > 0) { %>
<section class="pd-related container">
    <h2 class="pd-related-title">You may also like</h2>
    <div class="row g-3">
        <% relatedProducts.forEach(rp => { %>
        <div class="col-6 col-md-3">
            <div class="pd-card" onclick="window.location='/apb/fullproduct/<%= rp._id %>'">
                <div class="pd-card-img-wrap">
                    <% if(rp.badge && rp.badge !== 'No Badge') { %>
                        <span class="pd-card-badge"><%= rp.badge %></span>
                    <% } %>
                    <i class="pd-card-heart fa-regular fa-heart" onclick="event.stopPropagation(); toggleHeart(this)"></i>
                    <img src="<%= rp.image %>" alt="<%= rp.name %>">
                </div>
                <div class="pd-card-body">
                    <p class="pd-card-category"><%= rp.Category %></p>
                    <p class="pd-card-title"><%= rp.name %></p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="pd-card-stars">
                            <i class="fa-solid fa-star"></i>
                        </span>
                        <span class="pd-card-avg"><%= rp.rating %></span>
                        <span class="pd-card-count">(<%= rp.reviewCount %>)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="pd-card-price">₹<%= rp.Selling_price %></span>
                        <% if(rp.orginal_price && rp.orginal_price > rp.Selling_price) { 
                            let d = Math.round((1 - rp.Selling_price/rp.orginal_price)*100); %>
                            <span class="pd-card-disc"><%= d %>% off</span>
                        <% } %>
                    </div>
                    <button class="pd-card-btn" onclick="event.stopPropagation(); addToCart('<%= rp._id %>')">
                        <i class="fa-solid fa-cart-shopping"></i> Add to Cart
                    </button>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</section>
<% } %>

<!-- Toast -->
<div class="pd-toast" id="pdToast">
    <i class="fa-solid fa-circle-check"></i>
    <span id="pdToastMsg">Added to cart!</span>
</div>

<script src="/js/product_detail.js"></script>
