<%- layout("/layout/boilerplat.ejs") %>

<section class="section-pad search-results" style="padding-top:40px;">
  <div class="container">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h2 class="section-title mb-1">Search Results for <span class="grad-text">"<%= q %>"</span></h2>
        <p class="section-sub mb-0"><%= results.length %> product<%= results.length !== 1 ? 's' : '' %> found</p>
      </div>
      <a href="/apb/home" class="btn-signup-nav" style="font-size:.82rem;">
        <i class="fa fa-arrow-left me-1"></i> Back to Home
      </a>
    </div>

    <!-- No Results -->
    <% if(results.length === 0) { %>
    <div class="text-center py-5">
      <div style="font-size:4rem; margin-bottom:16px;">🔍</div>
      <h4 style="font-weight:700; color:var(--text);">No results found for "<%= q %>"</h4>
      <p style="color:var(--muted); margin-top:8px;">Try a different keyword or browse categories below.</p>
      <a href="/apb/home" class="btn-signup-nav mt-3 d-inline-block">Go to Home</a>
    </div>

    <% } else { %>

    <!-- Product Grid -->
    <div class="row g-4">
      <% results.forEach(function(item) { %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="prod-card" onclick="window.location='/apb/fullproduct/<%= item._id %>'" style="cursor:pointer;">
          <div class="prod-img-wrap">
            <img src="<%= item.image %>" alt="<%= item.name %>" 
              onerror="this.src='https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400'">
            <span class="prod-badge"><%= item.Category %></span>
            <div class="prod-wishlist"><i class="fa-regular fa-heart"></i></div>
          </div>
          <div class="prod-body">
            <div class="prod-cat"><%= item.Category %></div>
            <div class="prod-name"><%= item.name %></div>
            <div class="stars">
              <% let r = parseFloat(item.rating) || 0; %>
              <% for(let i=1;i<=5;i++){ %>
                <% if(i <= Math.floor(r)){ %><i class="fa-solid fa-star"></i>
                <% } else if(i - r < 1){ %><i class="fa-solid fa-star-half-stroke"></i>
                <% } else { %><i class="fa-regular fa-star"></i><% } %>
              <% } %>
              <span>(<%= item.rating || 'N/A' %>)</span>
            </div>
            <div class="prod-price">
              <span class="price-new">₹<%= item.Selling_price %></span>
              <% if(item.orginal_price && item.orginal_price > item.Selling_price) { %>
                <span class="price-old">₹<%= item.orginal_price %></span>
                <span class="price-save"><%= Math.round((1 - item.Selling_price/item.orginal_price)*100) %>% off</span>
              <% } %>
            </div>
            <button class="btn-cart" onclick="event.stopPropagation(); window.location='/apb/fullproduct/<%= item._id %>'">
              <i class="fa-solid fa-cart-plus me-2"></i>View Product
            </button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>

    <% } %>
  </div>
</section>
